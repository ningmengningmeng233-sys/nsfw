# ============================================================
# 小说索引 v4.8.4 - 配置模板
# 复制此文件为 .env 并填入你的配置（.env 已被 git 忽略）
# ============================================================

# ---- LLM API（支持任何 OpenAI 兼容 API） ----
# DeepSeek 示例；模型名按你的 API 实际值填写（如 deepseek-chat，或 v4-flash / v4-pro）：
OPENAI_API_KEY=sk-your-key-here
SUMMARY_API_URL=https://api.deepseek.com/v1/chat/completions
SUMMARY_API_MODEL=deepseek-chat

# ---- 索引库根目录（外置数据，不随技能包分发） ----
# 结构: <INDEX_LIB_DIR>/小说原文/  <INDEX_LIB_DIR>/小说索引/  <INDEX_LIB_DIR>/章节索引/
# 留空则默认 <技能目录>/索引库/
INDEX_LIB_DIR=

# ---- 建索引执行器（双执行器，ADR-0001 修订） ----
# direct   = 直调引擎（默认，32路并行+断点+双层行号校准，快）
# subagent = 子代理派发（需要宿主提供 Agent/子代理能力；不确定时使用 direct）
# 说明：本项无脚本消费，由编排器（AI）在阶段一第 5 步前读取本文件决定执行器——
# direct 跑 scripts/build_segment_index.py，subagent 按 references/建立索引.md 第四节派发。
INDEX_EXECUTOR=direct

# ---- 文风蒸馏扩展接口（ADR-0009） ----
# 完整文风蒸馏依赖外部 skill。留空则只输出轻量风格卡。
# 可填三种：外部 skill 目录（入口按 SKILL.md 的 style-entry → scripts/run_style.py
# → run.py 顺序解析）、.py 入口路径、或可执行命令字符串。详见 FAQ.md Q6。
INDEX_STYLE_SKILL=
# 风格卡契约文件 style-card.schema.json 的位置（一般不用填：默认用包内 schemas/
# 受控副本）。校验器见 scripts/style_card_schema.py。
INDEX_STYLE_CARD_SCHEMA=

# ---- 可选语义/向量检索（ADR-0004） ----
# 设置为 1 启用语义索引构建；需先安装可选依赖：
#   pip install "novel-index[semantic]"
# 手动构建：python scripts/semantic_index.py --build --lib <索引库>
# 语义检索：python scripts/semantic_search.py "查询" --lib <索引库>
# INDEX_ENABLE_SEMANTIC=0
# INDEX_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
